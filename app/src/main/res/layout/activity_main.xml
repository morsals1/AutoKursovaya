<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Заголовок -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="АвтоУчёт"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/groupManagementButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Семья"
            android:textSize="13sp"
            app:icon="@drawable/ic_group"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:cornerRadius="20dp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/text_secondary"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/logoutButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Выйти"
            android:textSize="13sp"
            app:icon="@drawable/ic_logout"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:cornerRadius="20dp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/text_secondary"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"/>

    </LinearLayout>

    <!-- Карточка информации об автомобиле -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/carInfoCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/carNameTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Volkswagen Golf 2018"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:id="@+id/currentMileageTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Текущий пробег: 85 430 км"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp"/>

            </LinearLayout>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_car"
                android:contentDescription="Автомобиль"
                app:tint="@color/primary"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Карточка статистики за месяц -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/monthStatsCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/carInfoCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/monthTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Сентябрь 2026"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"/>

            <TextView
                android:id="@+id/totalExpensesTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="24 850 ₽"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/monthComparisonTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="▼12% к прошлому месяцу"
                    android:textSize="13sp"
                    android:textColor="@color/green"/>

                <TextView
                    android:id="@+id/economyTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏆 -2 300 ₽"
                    android:textSize="13sp"
                    android:textColor="@color/green"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Карточка последних расходов -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/recentExpensesCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="15dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/monthStatsCard">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/recentExpensesTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ПОСЛЕДНИЕ ОПЕРАЦИИ"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:padding="12dp"
                android:background="@color/divider"
                android:alpha="0.5"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recentExpensesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/showAllExpensesButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Показать все записи"
                android:textColor="@color/primary"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_margin="8dp"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Нижняя навигация -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_navigation_menu"/>

    <!-- FAB кнопка -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addExpenseFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/primary"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Состояние "Пусто" -->
    <LinearLayout
        android:id="@+id/emptyStateLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/emptyStateIcon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_car_empty"
            android:layout_marginBottom="24dp"
            android:contentDescription="Иконка автомобиля"/>

        <!-- Добавлены ID -->
        <TextView
            android:id="@+id/emptyStateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Добавьте ваш первый автомобиль"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <!-- Добавлены ID -->
        <TextView
            android:id="@+id/emptyStateSubtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Начните отслеживать расходы на авто"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="8dp"/>

        <Button
            android:id="@+id/addFirstCarButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Добавить автомобиль"
            android:layout_marginTop="24dp"
            style="@style/Widget.MaterialComponents.Button"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>